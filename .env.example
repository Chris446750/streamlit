# ============================================================
# 环境变量模板
# 用法：复制本文件为 .env 后填入真实值（.env 已被 .gitignore 忽略，勿提交）
# ============================================================

# ---- DeepSeek 大模型 ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT_SEC=60
DEEPSEEK_MAX_RETRIES=3

# ---- 数据源（A股主力 AkShare，无需 token）----
DATA_PROVIDER=akshare
# DATA_TUSHARE_TOKEN=your_tushare_token   # 仅当 DATA_PROVIDER=tushare 时取消注释并填写
DATA_STOCK_POOL=600519,000001,300750
DATA_START_DATE=2020-01-01
DATA_KLINE_PERIOD=daily
DATA_REQUEST_INTERVAL_SEC=1.0

# ---- 回测 ----
BT_INITIAL_CAPITAL=1000000
BT_COMMISSION=0.0003
BT_SLIPPAGE=0.0002
BT_RISK_FREE_RATE=0.02
BT_STOP_LOSS_PCT=0.05
BT_TAKE_PROFIT_PCT=0.10

# ---- 推送（可选，取消注释并填写后启用）----
# NOTIFY_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# NOTIFY_TELEGRAM_CHAT_ID=123456789
# NOTIFY_SMTP_HOST=smtp.qq.com
# NOTIFY_SMTP_PORT=465
# NOTIFY_SMTP_USER=you@example.com
# NOTIFY_SMTP_PASSWORD=your_smtp_auth_code
# NOTIFY_SMTP_TO=target@example.com

# ---- 存储 ----
DB_ENGINE=sqlite
DB_SQLITE_PATH=data/market.db
# DB_POSTGRES_DSN=postgresql+psycopg2://user:pass@host:5432/db   # 仅当 DB_ENGINE=postgresql 时填写

# ---- 日志 ----
LOG_LEVEL=INFO
